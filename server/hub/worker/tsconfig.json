{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": []
  },
  "include": ["index.ts", "cloudflare.d.ts", "../core/*.ts", "../../core/*.ts", "../../../src/domain/*.ts", "../../../src/link/*.ts", "../../../src/legal/*.ts"]
}
